# Anthropic API Key (required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Claude Model (optional - default shown)
# Available models: claude-3-5-sonnet-20240620, claude-3-opus-20240229, etc.
# CLAUDE_MODEL=claude-3-5-sonnet-20240620

# Input/Output Paths (optional - defaults shown)
RESUME_PATH=input/resume.docx
JOB_DESC_PATH=input/job_description.txt
OUTPUT_PATH=output/optimized_resume.docx

# Bullet Point Character Limits (optional - defaults shown)
# Keep bullets between 180-220 chars to prevent resume overflow
MIN_BULLET_CHARS=180
MAX_BULLET_CHARS=220
